---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const { title, description = 'A short theology quiz that maps your beliefs onto the major Christian traditions.', wide = false } = Astro.props;
const fullTitle = title ? `${title} · Denomination Compass` : 'Denomination Compass';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/quiz', label: 'Quiz' },
  { href: '/results', label: 'Results' },
  { href: '/denominations', label: 'Traditions' },
  { href: '/doctrines', label: 'Doctrines' },
  { href: '/councils', label: 'Councils' },
  { href: '/creeds', label: 'Creeds' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..700,50&family=Inter:wght@400;500;600;700&display=swap"
    />
    <meta name="theme-color" content="#f5efe4" />
    <slot name="head" />
    <script is:inline>
      try {
        const t = localStorage.getItem('dc:theme');
        const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-30 border-b border-line/70 bg-bg/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-1.5 px-3 sm:gap-3 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 font-display text-[1.05rem] font-semibold tracking-tight">
          <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true">
            <circle cx="16" cy="16" r="15" fill="var(--ink)" />
            <path d="M16 4.5l2.4 9.1L27.5 16l-9.1 2.4L16 27.5l-2.4-9.1L4.5 16l9.1-2.4z" fill="var(--bg)" />
            <circle cx="16" cy="16" r="2.2" fill="var(--gold)" />
          </svg>
          <span class="hidden sm:inline">Denomination Compass</span>
        </a>
        <nav class="ml-auto hidden items-center gap-0.5 text-sm font-medium md:flex">
          {nav.map((n) => (
            <a
              href={n.href}
              class:list={[
                'rounded-full px-3 py-1.5 whitespace-nowrap transition-colors',
                path.startsWith(n.href) ? 'bg-surface-2 text-ink' : 'text-muted hover:text-ink',
              ]}
            >{n.label}</a>
          ))}
        </nav>
        <details class="group relative ml-auto md:hidden">
          <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-muted hover:bg-surface-2 hover:text-ink [&::-webkit-details-marker]:hidden" aria-label="Menu">
            <svg viewBox="0 0 24 24" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </summary>
          <div class="absolute top-full right-0 z-40 mt-2 w-48 rounded-2xl border border-line bg-surface p-1.5 shadow-2xl">
            {nav.map((n) => (
              <a
                href={n.href}
                class:list={['block rounded-xl px-3 py-2.5 text-[0.95rem] font-medium', path.startsWith(n.href) ? 'bg-surface-2 text-ink' : 'text-muted hover:bg-surface-2 hover:text-ink']}
              >{n.label}</a>
            ))}
          </div>
        </details>
        <button id="theme-toggle" class="grid size-9 flex-none place-items-center rounded-full text-muted hover:bg-surface-2 hover:text-ink" aria-label="Toggle dark mode">
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path class="dark:hidden" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            <g class="hidden dark:inline"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></g>
          </svg>
        </button>
      </div>
    </header>

    <main class:list={['mx-auto w-full flex-1 px-4 pb-16 sm:px-6', wide ? 'max-w-6xl' : 'max-w-5xl']}>
      <slot />
    </main>


    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('dc:theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>
