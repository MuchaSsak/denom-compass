---
import { icons } from '../data/icons';
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { LANGS, LANG_NAMES, OG_LOCALE, href, isLang, stripLang, useT, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const lang: Lang = isLang(Astro.params.lang) ? Astro.params.lang : 'en';
const t = useT(lang);
const siteName = t('Denomination Compass');
const { title, description: rawDescription = t('A short theology quiz that maps your beliefs onto the major Christian traditions.'), wide = false } = Astro.props;
/** Search snippets show ~155-160 chars: cut at a sentence end, else at a word. */
function metaDesc(s: string, max = 160) {
  s = s.replace(/\s+/g, ' ').trim();
  if (s.length <= max) return s;
  const cut = s.slice(0, max - 1);
  const dot = cut.lastIndexOf('. ');
  if (dot > 80) return cut.slice(0, dot + 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:(-]+$/, '') + '…';
}
const description = metaDesc(rawDescription);
const fullTitle = title ? `${title} · ${siteName}` : siteName;

const rest = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';
const path = rest;
const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (l: Lang) => new URL(href(l, rest === '/' ? '' : rest), site).href;
const ogImage = new URL(`/og-${lang}.png`, site).href;

/** Breadcrumb trail from the path: section page, then the current page. */
const sectionNames: Record<string, string> = { quiz: t('Quiz'), results: t('Results'), doctrines: t('Doctrines'), councils: t('Councils'), creeds: t('Creeds'), denominations: t('Traditions'), privacy: t('Privacy policy'), terms: t('Terms of use') };
const segs = rest.split('/').filter(Boolean);
const crumbs = segs.length === 0 ? [] : segs.length === 1
  ? [{ name: title ?? sectionNames[segs[0]] ?? segs[0], path: `/${segs[0]}` }]
  : [
      ...(segs[0] === 'denominations' ? [] : [{ name: sectionNames[segs[0]] ?? segs[0], path: `/${segs[0]}` }]),
      { name: title ?? segs[1], path: rest },
    ];

/** Author profiles (rel=me + schema.org sameAs). */
const SAME_AS: string[] = [
  'https://github.com/MuchaSsak',
  'https://www.linkedin.com/in/mateusz-muszarski-b1168a28a/',
  'https://www.npmjs.com/~muchassakkk',
  'https://www.instagram.com/mat.muszarski/',
  'https://www.facebook.com/muszarski',
  'https://t.me/MateuszMuszarski',
  'https://play.google.com/store/apps/dev?id=7961731162261862815',
  'https://apps.apple.com/developer/mateusz-muszarski/id1896558654',
];
const AUTHOR = { name: 'Mateusz Muszarski', alternateName: 'MuchaSsak', url: 'https://muszarski.com', jobTitle: 'Full-stack product engineer', sameAs: SAME_AS };
const keywords = lang === 'pl'
  ? 'quiz wyznań, test wyznania, kompas wyznań, chrześcijańskie wyznania, Kościoły chrześcijańskie, katolicyzm, prawosławie, protestantyzm, doktryny, sobory powszechne, wyznania wiary, teologia'
  : 'denomination quiz, Christian denomination test, which church am I, denomination compass, Christian traditions, Catholic, Orthodox, Protestant, doctrines, ecumenical councils, creeds, theology quiz';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(rest === '/' ? [{
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      name: siteName,
      alternateName: lang === 'pl' ? 'Denomination Compass' : 'Kompas denominacji',
      url: new URL(href(lang), site).href,
      inLanguage: lang,
      description: t('A short theology quiz that maps your beliefs onto the major Christian traditions.'),
      author: { '@id': 'https://muszarski.com/#person' },
      publisher: { '@id': 'https://muszarski.com/#person' },
    }] : []),
    { '@type': 'Person', '@id': 'https://muszarski.com/#person', ...AUTHOR },
    {
      '@type': 'WebPage',
      '@id': abs(lang),
      url: abs(lang),
      name: title ?? siteName,
      description,
      inLanguage: lang,
      isPartOf: { '@id': new URL('/#website', site).href },
      primaryImageOfPage: ogImage,
      ...(rest !== '/' && {
        breadcrumb: {
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: siteName, item: new URL(href(lang), site).href },
            ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: new URL(href(lang, c.path), site).href })),
          ],
        },
      }),
    },
  ],
};

const nav = [
  { href: '/quiz', label: t('Quiz') },
  { href: '/results', label: t('Results') },
  { href: '/doctrines', label: t('Doctrines') },
  { href: '/councils', label: t('Councils') },
  { href: '/creeds', label: t('Creeds') },
];
const active = (h: string) => path === h || path.startsWith(`${h}/`);

/** Small rounded flag icons (emoji flags don't render on Windows). */
function flag(l: Lang) {
  const inner = l === 'pl'
    ? '<rect width="20" height="7" fill="#fff"/><rect y="7" width="20" height="7" fill="#dc143c"/>'
    : '<rect width="20" height="14" fill="#012169"/><path d="M0 0l20 14M20 0L0 14" stroke="#fff" stroke-width="2.8"/><path d="M0 0l20 14M20 0L0 14" stroke="#c8102e" stroke-width="1.2"/><path d="M10 0v14M0 7h20" stroke="#fff" stroke-width="4.6"/><path d="M10 0v14M0 7h20" stroke="#c8102e" stroke-width="2.6"/>';
  return `<svg viewBox="0 0 20 14" width="20" height="14" aria-hidden="true" style="border-radius:3px;box-shadow:0 0 0 1px rgb(0 0 0 / .12);flex:none"><clipPath id="f${l}"><rect width="20" height="14" rx="3"/></clipPath><g clip-path="url(#f${l})">${inner}</g></svg>`;
}
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={AUTHOR.name} />
    <link rel="author" href={AUTHOR.url} />
    {SAME_AS.slice(0, 2).map((u) => <link rel="me" href={u} />)}
    <link rel="canonical" href={abs(lang)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('en')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f5efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('Denomination Compass: which Christian tradition shares your beliefs?')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <script is:inline define:vars={{ lang }}>
      try {
        const t = localStorage.getItem('dc:theme');
        const dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        localStorage.setItem('dc:lang', lang);
      } catch {}
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" set:html={Object.entries(icons).map(([k, v]) => `<symbol id="ic-${k}" viewBox="0 0 48 48">${v}</symbol>`).join('')} />
    <header class="sticky top-0 z-30 border-b border-line/70 bg-bg/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-1.5 px-3 sm:gap-3 sm:px-6">
        <a href={href(lang)} aria-label={siteName} class="flex items-center gap-2.5 font-display text-[1.05rem] font-semibold tracking-tight">
          <svg viewBox="0 0 32 32" class="size-8" aria-hidden="true">
            <circle cx="16" cy="16" r="15" fill="var(--ink)" />
            <path d="M16 4.5l2.4 9.1L27.5 16l-9.1 2.4L16 27.5l-2.4-9.1L4.5 16l9.1-2.4z" fill="var(--bg)" />
            <circle cx="16" cy="16" r="2.2" fill="var(--gold)" />
          </svg>
          <span class="hidden sm:inline">{siteName}</span>
        </a>
        <nav class="ml-auto hidden items-center gap-0.5 text-sm font-medium md:flex">
          {nav.map((n) => (
            <a
              href={href(lang, n.href)}
              class:list={['rounded-full px-3 py-1.5 whitespace-nowrap transition-colors', active(n.href) ? 'bg-surface-2 text-ink' : 'text-muted hover:text-ink']}
            >{n.label}</a>
          ))}
        </nav>
        <details class="group relative ml-auto md:hidden">
          <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-muted hover:bg-surface-2 hover:text-ink [&::-webkit-details-marker]:hidden" aria-label={t('Menu')}>
            <svg viewBox="0 0 24 24" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </summary>
          <div class="absolute top-full right-0 z-40 mt-2 w-52 rounded-2xl border border-line bg-surface p-1.5 shadow-2xl">
            {nav.map((n) => (
              <a
                href={href(lang, n.href)}
                class:list={['block rounded-xl px-3 py-2.5 text-[0.95rem] font-medium', active(n.href) ? 'bg-surface-2 text-ink' : 'text-muted hover:bg-surface-2 hover:text-ink']}
              >{n.label}</a>
            ))}
            <div class="my-1 border-t border-line"></div>
            <a href={href(lang, '/privacy')} class="block rounded-xl px-3 py-2 text-sm text-muted hover:bg-surface-2 hover:text-ink">{t('Privacy')}</a>
            <a href={href(lang, '/terms')} class="block rounded-xl px-3 py-2 text-sm text-muted hover:bg-surface-2 hover:text-ink">{t('Terms')}</a>
          </div>
        </details>

        <!-- language: flag of the current language, dropdown with both -->
        <details class="group/lang relative flex-none" id="lang-menu">
          <summary class="grid size-9 cursor-pointer list-none place-items-center rounded-full hover:bg-surface-2 [&::-webkit-details-marker]:hidden" aria-label={t('Language')} title={LANG_NAMES[lang]}>
            <Fragment set:html={flag(lang)} />
          </summary>
          <div class="absolute top-full right-0 z-40 mt-2 w-40 rounded-2xl border border-line bg-surface p-1.5 shadow-2xl">
            {LANGS.map((l) => (
              <a
                href={href(l, rest === '/' ? '' : rest)}
                hreflang={l}
                lang={l}
                data-lang={l}
                class:list={['flex items-center gap-2.5 rounded-xl px-3 py-2 text-sm font-medium', l === lang ? 'bg-surface-2 text-ink' : 'text-muted hover:bg-surface-2 hover:text-ink']}
                aria-current={l === lang ? 'true' : undefined}
              ><Fragment set:html={flag(l)} />{LANG_NAMES[l]}</a>
            ))}
          </div>
        </details>

        <button id="theme-toggle" class="grid size-9 flex-none place-items-center rounded-full text-muted hover:bg-surface-2 hover:text-ink" aria-label={t('Toggle dark mode')}>
          <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path class="dark:hidden" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            <g class="hidden dark:inline"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></g>
          </svg>
        </button>
      </div>
    </header>

    <main class:list={['mx-auto w-full flex-1 px-4 pb-16 sm:px-6', wide ? 'max-w-6xl' : 'max-w-5xl']}>
      <slot />
    </main>

    <footer class="border-t border-line/70">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-5 text-sm text-muted sm:px-6">
        <p>{t('Made by')} <a href="https://muszarski.com" rel="author" class="font-medium text-ink underline decoration-muted/50 underline-offset-4 transition-colors hover:decoration-gold">Mateusz Muszarski</a></p>
        <a href={href(lang, '/privacy')} class="py-2 transition-colors hover:text-ink">{t('Privacy policy')}</a>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('dc:theme', dark ? 'dark' : 'light'); } catch {}
      });
      // Language links keep the share-hash (#a=…) and remember the choice; menus close on outside click.
      document.querySelectorAll('#lang-menu a[data-lang]').forEach((a) => {
        a.addEventListener('click', () => {
          try { localStorage.setItem('dc:lang', a.dataset.lang); } catch {}
          if (location.hash) a.href = a.href.split('#')[0] + location.hash;
        });
      });
      document.addEventListener('click', (e) => {
        document.querySelectorAll('header details[open]').forEach((d) => { if (!d.contains(e.target)) d.removeAttribute('open'); });
      });
    </script>
  </body>
</html>
