---
interface Props { id: string; color: string; fg?: string; size?: number; class?: string }
const { id, color, fg = '#fff', size = 48, class: cls = '' } = Astro.props;
---
<span
  class:list={['badge', cls]}
  style={`width:${size}px;height:${size}px;background:${color};color:${fg};--icon-bg:${color};`}
>
  <svg viewBox="0 0 48 48" style={`width:${size * 0.62}px;height:${size * 0.62}px`} aria-hidden="true"><use href={`#ic-${id}`} /></svg>
</span>
