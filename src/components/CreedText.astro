---
import type { Part } from '../data/creeds';
import Annotated from './Annotated.astro';
import AnnotTip from './AnnotTip.astro';
interface Props { text: Part[][] }
const { text } = Astro.props;
---
<div class="creed font-display break-words hyphens-auto text-[1.2rem] leading-[1.75] sm:text-[1.35rem]">
  {text.map((para) => <p><Annotated parts={para} /></p>)}
</div>
<AnnotTip />

<style>
  .creed p + p { margin-top: 1rem; }
</style>
