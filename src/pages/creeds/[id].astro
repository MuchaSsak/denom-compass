---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import CreedText from '../../components/CreedText.astro';
import { creeds, type Creed } from '../../data/creeds';
import { denominationById } from '../../data/denominations';

export function getStaticPaths() {
  return creeds.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props as { c: Creed };
const others = creeds.filter((x) => x.id !== c.id);
---
<Base title={c.name} description={c.tagline} wide>
  <a href="/creeds" class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-muted hover:text-ink">← All creeds</a>

  <div class="mt-4 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
    <article class="card p-6 sm:p-10">
      <p class="eyebrow">{c.date}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{c.name}</h1>
      <p class="mt-2 text-lg text-muted">{c.tagline}</p>
      <p class="mt-6 flex items-center gap-2 text-xs font-semibold text-muted">
        <span class="inline-block h-0.5 w-6 border-b-2 border-dotted border-gold"></span>
        Hover or tap underlined phrases for explanations
      </p>
      <div class="mt-5 border-l-2 border-gold/50 pl-5 sm:pl-7">
        <CreedText text={c.text} />
      </div>
      {c.fullTextNote && <p class="mt-6 text-sm text-muted">{c.fullTextNote}</p>}
    </article>

    <aside class="flex flex-col gap-6">
      <section class="card p-6">
        <h2 class="text-[11px] font-bold tracking-widest text-muted uppercase">Origin</h2>
        <p class="mt-2 leading-relaxed">{c.origin}</p>
        <h2 class="mt-5 text-[11px] font-bold tracking-widest text-muted uppercase">In short</h2>
        <ul class="mt-2 grid gap-1.5">
          {c.keyPoints.map((k) => <li class="flex gap-2"><span class="mt-[8px] size-1.5 flex-none rounded-full bg-gold"></span>{k}</li>)}
        </ul>
      </section>

      <section class="card p-6">
        <h2 class="font-display text-xl font-semibold">Confessed by</h2>
        <ul class="mt-3 grid gap-2">
          {c.usedBy.map((u) => {
            const d = denominationById[u.id];
            return (
              <li><a href={`/denominations/${d.id}`} class="flex items-center gap-3 rounded-xl p-1 transition hover:bg-surface-2">
                <Badge id={d.id} color={d.color} size={30} />
                <span class="min-w-0"><span class="block text-sm font-semibold">{d.short}</span>{u.note && <span class="block text-xs text-muted">{u.note}</span>}</span>
              </a></li>
            );
          })}
        </ul>
        {c.rejectedBy && c.rejectedBy.length > 0 && (
          <>
            <h3 class="mt-5 text-[11px] font-bold tracking-widest text-muted uppercase">Not used by</h3>
            <ul class="mt-2 grid gap-2">
              {c.rejectedBy.map((u) => {
                const d = denominationById[u.id];
                return (
                  <li><a href={`/denominations/${d.id}`} class="flex items-center gap-3 rounded-xl p-1 opacity-80 transition hover:bg-surface-2 hover:opacity-100">
                    <Badge id={d.id} color={d.color} size={26} />
                    <span class="min-w-0"><span class="block text-sm font-semibold">{d.short}</span>{u.note && <span class="block text-xs text-muted">{u.note}</span>}</span>
                  </a></li>
                );
              })}
            </ul>
          </>
        )}
      </section>

      <nav class="grid gap-2">
        {others.map((o) => (
          <a href={`/creeds/${o.id}`} class="card flex items-center justify-between gap-3 px-5 py-3.5 text-sm font-semibold transition hover:-translate-y-0.5">
            {o.name}<span class="text-muted">{o.date} →</span>
          </a>
        ))}
      </nav>
    </aside>
  </div>
</Base>
