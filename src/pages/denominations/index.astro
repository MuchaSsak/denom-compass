---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { denominations, families } from '../../data/denominations';

const groups = families
  .map((f) => ({ family: f, items: denominations.filter((d) => d.family === f) }))
  .filter((g) => g.items.length);
const familyNote: Record<string, string> = {
  Catholic: 'In communion with the Bishop of Rome.',
  Orthodox: 'The ancient churches of the East.',
  'Church of the East': 'The church of the Persian Empire and the Silk Road.',
  Protestant: 'Heirs of the 16th-century Reformation and the revivals that followed.',
  Restorationist: 'Movements seeking to restore New Testament Christianity without creeds.',
  Nontrinitarian: 'Identify as Christian but reject the Nicene Trinity — not recognised as Christian by Catholic, Orthodox or most Protestant churches.',
};
---
<Base title="Traditions" wide>
  <header class="pt-12 pb-4 sm:pt-16">
    <p class="eyebrow">The traditions</p>
    <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{denominations.length} ways of being Christian</h1>
    <p class="mt-3 max-w-2xl text-muted">Each profile lists the councils a tradition accepts, its key doctrines and what sets it apart — at a glance.</p>
  </header>

  {groups.map((g) => (
    <section class="mt-10">
      <div class="mb-4 flex items-baseline gap-3 border-b border-line pb-2">
        <h2 class="font-display text-2xl font-semibold">{g.family}</h2>
        <p class="text-sm text-muted">{familyNote[g.family]}</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {g.items.map((d) => (
          <a href={`/denominations/${d.id}`} class="card group flex gap-4 p-5 transition hover:-translate-y-0.5">
            <Badge id={d.id} color={d.color} size={52} />
            <div class="min-w-0">
              <p class="font-semibold leading-tight">{d.name}</p>
              <p class="mt-1 line-clamp-2 text-sm text-muted">{d.tagline}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <span class="chip">Since {d.origin.year}</span>
                {d.notice?.tone === 'caution' && <span class="chip border-amber-500/40 bg-amber-500/10 text-ink">Non-Nicene</span>}
                <span class="chip">{d.councils.length ? `${d.councils.length} council${d.councils.length > 1 ? 's' : ''}` : 'No councils'}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Base>
