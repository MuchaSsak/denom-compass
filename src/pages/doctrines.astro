---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { topics } from '../data/topics';
import { questions } from '../data/questions';
import { denominations } from '../data/denominations';

/** For each option: traditions whose stance on it is ≥ 0.5 (strong = dominant ≥ 0.75). */
function holders(qid: string, oid: string) {
  return denominations
    .map((d) => ({ d, s: d.stances[qid]?.[oid] ?? 0 }))
    .filter((x) => x.s >= 0.5)
    .sort((a, b) => b.s - a.s);
}
---
<Base title="Doctrines" wide>
  <header class="pt-12 pb-2 sm:pt-16">
    <p class="eyebrow">Doctrines compared</p>
    <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">Who believes what</h1>
    <p class="mt-3 max-w-2xl text-muted">
      Every quiz question, with the traditions that hold each answer. Solid badges hold it firmly; faded ones are divided on it.
    </p>
  </header>

  <nav class="sticky top-16 z-20 -mx-4 mt-6 overflow-x-auto border-y border-line/70 bg-bg/85 px-4 py-2.5 backdrop-blur-md sm:mx-0 sm:rounded-full sm:border sm:px-2">
    <ul class="flex gap-1 text-sm font-medium whitespace-nowrap">
      {topics.map((t) => <li><a href={`#${t.id}`} class="block rounded-full px-3 py-1 text-muted hover:bg-surface-2 hover:text-ink">{t.title}</a></li>)}
    </ul>
  </nav>

  <div class="mt-8 flex flex-col gap-6">
    {topics.map((t) => {
      const qs = questions.filter((q) => q.topic === t.id);
      return (
        <section id={t.id} class="card scroll-mt-32 p-6 sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[1fr_1.35fr]">
            <div>
              <h2 class="font-display text-3xl font-semibold">{t.title}</h2>
              <p class="mt-3 leading-relaxed">{t.summary}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">{t.scripture.map((s) => <span class="chip">{s}</span>)}</div>
              <p class="mt-4 border-l-2 border-gold pl-3 text-sm text-muted">{t.milestone}</p>
            </div>
            <div class="flex flex-col gap-5">
              {qs.map((q) => (
                <div>
                  <p class="font-semibold">{q.text}</p>
                  <ul class="mt-2.5 grid gap-2">
                    {q.options.map((o) => {
                      const hs = holders(q.id, o.id);
                      return (
                        <li class="flex items-center gap-3 rounded-xl bg-surface-2/70 px-3 py-2">
                          <span class="w-36 flex-none text-sm font-medium sm:w-44">{o.short ?? o.label}</span>
                          <span class="flex flex-wrap gap-1">
                            {hs.length === 0 && <span class="text-xs text-muted">—</span>}
                            {hs.map(({ d, s }) => (
                              <a href={`/denominations/${d.id}`} title={`${d.name}${s < 0.75 ? ' (divided)' : ''}`} style={s < 0.75 ? 'opacity:.4' : ''} class="transition hover:scale-110 hover:opacity-100">
                                <Badge id={d.id} color={d.color} size={26} />
                              </a>
                            ))}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <section class="card mt-10 p-6">
    <h2 class="text-[11px] font-bold tracking-widest text-muted uppercase">Legend</h2>
    <div class="mt-3 grid gap-2 sm:grid-cols-3 lg:grid-cols-6">
      {denominations.map((d) => (
        <a href={`/denominations/${d.id}`} class="flex items-center gap-2 text-sm hover:underline">
          <Badge id={d.id} color={d.color} size={24} />{d.short}
        </a>
      ))}
    </div>
  </section>
</Base>
