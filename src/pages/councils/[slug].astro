---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { councils, councilSlug } from '../../data/councils';
import { councilDetails } from '../../data/councilDetails';
import { creeds } from '../../data/creeds';
import { topicTitles } from '../../data/topics';
import { denominations } from '../../data/denominations';
import type { Council } from '../../data/types';

export function getStaticPaths() {
  return councils.map((c) => ({ params: { slug: councilSlug(c) }, props: { c } }));
}
const { c } = Astro.props as { c: Council };
const x = councilDetails[c.n];
const received = denominations.filter((d) => d.councils.includes(c.n));
const notReceived = denominations.filter((d) => !d.councils.includes(c.n));
const prev = councils[c.n - 2];
const next = councils[c.n];
const relCreeds = (x?.creeds ?? []).map((id) => creeds.find((k) => k.id === id)).filter(Boolean);
const facts = [
  ['When', c.year],
  ['Where', c.place],
  ['Called by', x?.convokedBy],
  ['Presided', x?.presided],
  ['Present', x?.attendance],
].filter(([, v]) => v);
---
<Base title={c.name} description={c.summary} wide>
  <a href="/councils" class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-muted hover:text-ink">← All councils</a>

  <div class="mt-4 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
    <article class="card p-6 sm:p-10">
      <p class="eyebrow">Council #{c.n} · {c.year}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{c.name}</h1>
      <p class="mt-3 font-display text-xl leading-relaxed">{c.summary}</p>

      {x && (
        <>
          <p class="mt-6 leading-relaxed">{x.context}</p>

          <div class="mt-6 rounded-2xl bg-surface-2/70 p-5">
            <h2 class="text-[11px] font-bold tracking-widest text-muted uppercase">The issue · {x.issue.name}</h2>
            <p class="mt-2 border-l-2 border-gold/60 pl-3 italic">{x.issue.view}</p>
          </div>

          {x.term && (
            <p class="mt-6 flex flex-wrap items-baseline gap-x-3">
              <span class="font-display text-3xl font-semibold text-gold italic">{x.term.word}</span>
              <span class="text-muted">“{x.term.gloss}”</span>
            </p>
          )}
        </>
      )}

      <h2 class="mt-8 text-[11px] font-bold tracking-widest text-muted uppercase">Decided</h2>
      <ul class="mt-2 grid gap-1.5">
        {c.decisions.map((k) => <li class="flex gap-2"><span class="mt-[9px] size-1.5 flex-none rounded-full bg-gold"></span>{k}</li>)}
      </ul>

      {x && (
        <>
          <h2 class="mt-8 text-[11px] font-bold tracking-widest text-muted uppercase">Afterwards</h2>
          <p class="mt-2 leading-relaxed">{x.outcome}</p>
        </>
      )}
    </article>

    <aside class="flex flex-col gap-6">
      <section class="card p-6">
        <dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-2.5 text-sm">
          {facts.map(([k, v]) => (<><dt class="font-semibold text-muted">{k}</dt><dd>{v}</dd></>))}
        </dl>
        {x && x.figures.length > 0 && (
          <>
            <h2 class="mt-5 text-[11px] font-bold tracking-widest text-muted uppercase">Key figures</h2>
            <ul class="mt-2 grid gap-1.5 text-sm">
              {x.figures.map((f) => {
                const [name, role] = f.split(' — ');
                return <li><span class="font-semibold">{name}</span>{role && <span class="text-muted"> — {role}</span>}</li>;
              })}
            </ul>
          </>
        )}
      </section>

      <section class="card p-6">
        <h2 class="font-display text-xl font-semibold">Received by</h2>
        {received.length ? (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {received.map((d) => (
              <li><a href={`/denominations/${d.id}`} title={d.name} class="flex items-center gap-1.5 rounded-full bg-surface-2/70 py-0.5 pr-2.5 pl-0.5 text-xs font-semibold transition hover:bg-surface-2">
                <Badge id={d.id} color={d.color} size={24} />{d.short}
              </a></li>
            ))}
          </ul>
        ) : <p class="mt-2 text-sm text-muted">None of the traditions here.</p>}

        {x && x.dissent.length > 0 && (
          <>
            <h3 class="mt-5 text-[11px] font-bold tracking-widest text-muted uppercase">Not received</h3>
            <ul class="mt-2 grid gap-2 text-sm">
              {x.dissent.map((r) => <li><span class="font-semibold">{r.who}</span> <span class="text-muted">— {r.why}</span></li>)}
            </ul>
          </>
        )}
        <p class="mt-4 flex flex-wrap gap-1 opacity-45" title="Not received">
          {notReceived.map((d) => <a href={`/denominations/${d.id}`} title={d.name}><Badge id={d.id} color={d.color} size={20} /></a>)}
        </p>
      </section>

      {(relCreeds.length > 0 || (x?.topics ?? []).length > 0) && (
        <section class="flex flex-wrap gap-1.5">
          {relCreeds.map((k) => <a href={`/creeds/${k!.id}`} class="chip hover:text-ink">{k!.name} →</a>)}
          {(x?.topics ?? []).map((t) => <a href={`/doctrines#${t}`} class="chip hover:text-ink">{topicTitles[t] ?? t} →</a>)}
        </section>
      )}
    </aside>
  </div>

  <nav class="mt-8 grid gap-3 sm:grid-cols-2">
    {prev ? (
      <a href={`/councils/${councilSlug(prev)}`} class="card flex flex-col px-5 py-4 transition hover:-translate-y-0.5">
        <span class="text-xs text-muted">← #{prev.n} · {prev.year}</span><span class="font-semibold">{prev.name}</span>
      </a>
    ) : <span></span>}
    {next && (
      <a href={`/councils/${councilSlug(next)}`} class="card flex flex-col items-end px-5 py-4 text-right transition hover:-translate-y-0.5">
        <span class="text-xs text-muted">#{next.n} · {next.year} →</span><span class="font-semibold">{next.name}</span>
      </a>
    )}
  </nav>
</Base>
