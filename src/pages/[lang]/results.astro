---
import Base from '../../layouts/Base.astro';
import Results from '../../components/Results.svelte';
import { dataFor } from '../../data/localized';
import { langPaths, useT, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { questions, denominations } = dataFor(lang);
---
<Base title={t('Your results')} wide>
  <Results client:only="svelte" {questions} {denominations} {lang} />
</Base>
