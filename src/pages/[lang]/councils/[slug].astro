---
import Base from '../../../layouts/Base.astro';
import Badge from '../../../components/Badge.astro';
import Annotated from '../../../components/Annotated.astro';
import AnnotTip from '../../../components/AnnotTip.astro';
import { councils as baseCouncils, councilSlug } from '../../../data/councils';
import { councilMatters } from '../../../data/councilMatters';
import { dataFor } from '../../../data/localized';
import { makeGlosser } from '../../../lib/gloss';
import { LANGS, useT, href, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => baseCouncils.map((c) => ({ params: { lang, slug: councilSlug(c) }, props: { n: c.n } })));
}
const lang = Astro.params.lang as Lang;
const { n } = Astro.props as { n: number };
const t = useT(lang);
const { councils, councilDetails, creeds, topicTitles, denominations } = dataFor(lang);
const c = councils[n - 1];
const x = councilDetails[n];
const matters = councilMatters[n]?.[lang];
const g = makeGlosser(lang, x?.term ? [x.term.word] : []);

const received = denominations.filter((d) => d.councils.includes(n));
const notReceived = denominations.filter((d) => !d.councils.includes(n));
const prev = councils[n - 2];
const next = councils[n];
const relCreeds = (x?.creeds ?? []).map((id) => creeds.find((k) => k.id === id)!).filter(Boolean);
const facts = [
  [t('When'), c.year],
  [t('Where'), c.place],
  [t('Called by'), x?.convokedBy],
  [t('Presided'), x?.presided],
  [t('Present'), x?.attendance],
].filter(([, v]) => v) as [string, string][];

// Gloss in reading order so each term is explained where it first appears.
const summary = g(c.summary);
const context = x ? g(x.context) : [];
const issue = x ? g(x.issue.view) : [];
const decisions = c.decisions.map(g);
const outcome = x ? g(x.outcome) : [];
const dissent = (x?.dissent ?? []).map((r) => ({ who: r.who, why: g(r.why) }));
const mattersParts = matters ? g(matters) : [];
const fullName = lang === 'pl' ? `Sobór ${c.name.charAt(0).toLowerCase()}${c.name.slice(1)}` : `${t('Council of')} ${c.name}`;
---
<Base title={fullName} description={c.summary} wide>
  <a href={href(lang, '/councils')} class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-muted hover:text-ink">← {t('All councils')}</a>

  <div class="mt-4 grid gap-6 lg:grid-cols-[1.5fr_1fr]">
    <article class="card p-6 sm:p-10">
      <p class="eyebrow">{t('Council #{n}', { n })} · {c.year}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{c.name}</h1>
      <p class="mt-3 font-display text-xl leading-relaxed"><Annotated parts={summary} /></p>

      {x && (
        <>
          <p class="mt-6 leading-relaxed"><Annotated parts={context} /></p>

          <div class="mt-6 rounded-2xl bg-surface-2/70 p-5">
            <h2 class="text-[11px] font-bold tracking-widest text-muted uppercase">{t('The issue')} · {x.issue.name}</h2>
            <p class="mt-2 border-l-2 border-gold/60 pl-3 italic"><Annotated parts={issue} /></p>
          </div>

          {x.term && (
            <p class="mt-6 flex flex-wrap items-baseline gap-x-3">
              <span class="font-display text-3xl font-semibold text-gold italic">{x.term.word}</span>
              <span class="text-muted">„{x.term.gloss}”</span>
            </p>
          )}
        </>
      )}

      <h2 class="mt-8 text-[11px] font-bold tracking-widest text-muted uppercase">{t('Decided')}</h2>
      <ul class="mt-2 grid gap-1.5">
        {decisions.map((k) => <li class="flex gap-2"><span class="mt-[9px] size-1.5 flex-none rounded-full bg-gold"></span><span><Annotated parts={k} /></span></li>)}
      </ul>

      {x && (
        <>
          <h2 class="mt-8 text-[11px] font-bold tracking-widest text-muted uppercase">{t('Afterwards')}</h2>
          <p class="mt-2 leading-relaxed"><Annotated parts={outcome} /></p>
        </>
      )}

      {matters && (
        <div class="mt-8 flex gap-3 rounded-2xl border border-gold/40 bg-gold/10 p-5">
          <svg viewBox="0 0 20 20" class="mt-0.5 size-5 flex-none text-gold" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2.5l2.2 4.6 5 .7-3.6 3.5.9 5-4.5-2.4-4.5 2.4.9-5L2.8 7.8l5-.7z" /></svg>
          <div>
            <h2 class="text-[11px] font-bold tracking-widest text-gold uppercase">{t('Why it matters today')}</h2>
            <p class="mt-1 leading-relaxed"><Annotated parts={mattersParts} /></p>
          </div>
        </div>
      )}
    </article>

    <aside class="flex flex-col gap-6">
      <section class="card p-6">
        <dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-2.5 text-sm">
          {facts.map(([k, v]) => (<><dt class="font-semibold text-muted">{k}</dt><dd>{v}</dd></>))}
        </dl>
        {x && x.figures.length > 0 && (
          <>
            <h2 class="mt-5 text-[11px] font-bold tracking-widest text-muted uppercase">{t('Key figures')}</h2>
            <ul class="mt-2 grid gap-1.5 text-sm">
              {x.figures.map((f) => {
                const cut = f.indexOf(' - ');
                const [name, role] = cut < 0 ? [f, ''] : [f.slice(0, cut), f.slice(cut + 3)];
                return <li><span class="font-semibold">{name}</span>{role && <span class="text-muted"> - {role}</span>}</li>;
              })}
            </ul>
          </>
        )}
      </section>

      <section class="card p-6">
        <h2 class="font-display text-xl font-semibold">{t('Received by')}</h2>
        {received.length ? (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {received.map((d) => (
              <li><a href={href(lang, `/denominations/${d.id}`)} title={d.name} class="flex items-center gap-1.5 rounded-full bg-surface-2/70 py-0.5 pr-2.5 pl-0.5 text-xs font-semibold transition hover:bg-surface-2">
                <Badge id={d.id} color={d.color} size={24} />{d.short}
              </a></li>
            ))}
          </ul>
        ) : <p class="mt-2 text-sm text-muted">{t('None of the traditions here.')}</p>}

        {dissent.length > 0 && (
          <>
            <h3 class="mt-5 text-[11px] font-bold tracking-widest text-muted uppercase">{t('Not received')}</h3>
            <ul class="mt-2 grid gap-2 text-sm">
              {dissent.map((r) => <li><span class="font-semibold">{r.who}</span> <span class="text-muted"> - <Annotated parts={r.why} /></span></li>)}
            </ul>
          </>
        )}
        {notReceived.length > 0 && (
          <p class="mt-4 flex flex-wrap gap-1 opacity-45" title={t('Not received')}>
            {notReceived.map((d) => <a href={href(lang, `/denominations/${d.id}`)} title={d.name}><Badge id={d.id} color={d.color} size={20} /></a>)}
          </p>
        )}
      </section>

      {(relCreeds.length > 0 || (x?.topics ?? []).length > 0) && (
        <section class="flex flex-wrap gap-1.5">
          {relCreeds.map((k) => <a href={href(lang, `/creeds/${k.id}`)} class="chip hover:text-ink">{k.name} →</a>)}
          {(x?.topics ?? []).map((tp) => <a href={href(lang, `/doctrines#${tp}`)} class="chip hover:text-ink">{topicTitles[tp] ?? tp} →</a>)}
        </section>
      )}
    </aside>
  </div>

  <nav class="mt-8 grid gap-3 sm:grid-cols-2">
    {prev ? (
      <a href={href(lang, `/councils/${councilSlug(prev)}`)} class="card flex flex-col px-5 py-4 transition hover:-translate-y-0.5">
        <span class="text-xs text-muted">← #{prev.n} · {prev.year}</span><span class="font-semibold">{prev.name}</span>
      </a>
    ) : <span></span>}
    {next && (
      <a href={href(lang, `/councils/${councilSlug(next)}`)} class="card flex flex-col items-end px-5 py-4 text-right transition hover:-translate-y-0.5">
        <span class="text-xs text-muted">#{next.n} · {next.year} →</span><span class="font-semibold">{next.name}</span>
      </a>
    )}
  </nav>
  <AnnotTip />
</Base>
