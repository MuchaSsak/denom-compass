---
import Base from '../../../layouts/Base.astro';
import Badge from '../../../components/Badge.astro';
import { dataFor } from '../../../data/localized';
import { langPaths, useT, href, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { creeds, confessions, denominationById } = dataFor(lang);
---
<Base title={t('Creeds')} description={t('The great creeds of Christianity, phrase by phrase, and who confesses them.')} wide>
  <header class="pt-12 pb-2 sm:pt-16">
    <p class="eyebrow">{t('Creeds & confessions')}</p>
    <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{t('What Christians confess together')}</h1>
  </header>

  <section class="mt-8 grid gap-4 md:grid-cols-2">
    {creeds.map((c) => (
      <a href={href(lang, `/creeds/${c.id}`)} class="card group flex min-w-0 flex-col p-6 transition hover:-translate-y-0.5">
        <div class="flex items-baseline justify-between gap-3">
          <h2 class="font-display text-2xl font-semibold">{c.name}</h2>
          <span class="chip flex-none">{c.date}</span>
        </div>
        <p class="mt-2 text-muted">{c.tagline}</p>
        <ul class="mt-4 grid gap-1.5 text-sm">
          {c.keyPoints.map((k) => <li class="flex gap-2"><span class="mt-[7px] size-1.5 flex-none rounded-full bg-gold"></span>{k}</li>)}
        </ul>
        <div class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4">
          <span class="flex -space-x-1.5">
            {c.usedBy.slice(0, 8).map((u) => <Badge id={u.id} color={denominationById[u.id].color} size={26} class="ring-2 ring-[var(--surface)]" />)}
          </span>
          <span class="text-sm font-semibold">{t('Read')} →</span>
        </div>
      </a>
    ))}
  </section>

  <section class="mt-16">
    <div class="mb-5 flex flex-wrap items-baseline gap-x-3 border-b border-line pb-2">
      <h2 class="font-display text-2xl font-semibold">{t('Later confessions')}</h2>
    </div>
    <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {confessions.map((c) => (
        <li class="card flex gap-4 p-5">
          <span class="flex flex-none flex-col items-center gap-2">
            {c.ids.map((id) => <a href={href(lang, `/denominations/${id}`)} title={denominationById[id].name}><Badge id={id} color={denominationById[id].color} size={34} /></a>)}
          </span>
          <span class="min-w-0">
            <span class="block font-semibold leading-tight">{c.name}</span>
            <span class="text-xs font-semibold text-gold">{c.year}</span>
            <span class="mt-1 block text-sm leading-snug text-muted">{c.text}</span>
          </span>
        </li>
      ))}
    </ol>
  </section>
</Base>
