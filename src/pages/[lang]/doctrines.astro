---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { dataFor } from '../../data/localized';
import { langPaths, useT, href, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { topics, questions, denominations } = dataFor(lang);

/** For each option: traditions whose stance on it is ≥ 0.5 (strong = dominant ≥ 0.75). */
function holders(qid: string, oid: string) {
  return denominations
    .map((d) => ({ d, s: d.stances[qid]?.[oid] ?? 0 }))
    .filter((x) => x.s >= 0.5)
    .sort((a, b) => b.s - a.s);
}
---
<Base title={t('Doctrines')} description={t('Who believes what: the big doctrinal questions, tradition by tradition.')} wide>
  <header class="pt-12 pb-2 sm:pt-16">
    <p class="eyebrow">{t('Doctrines compared')}</p>
    <h1 class="mt-2 font-display text-4xl font-semibold sm:text-5xl">{t('Who believes what')}</h1>
    <p class="mt-3 text-sm text-muted">{t('Faded = divided.')}</p>
  </header>

  <nav id="topic-nav" class="group/nav sticky top-16 z-20 -mx-4 mt-6 border-y border-line/70 bg-bg/85 backdrop-blur-md sm:mx-0 sm:rounded-full sm:border">
    <button type="button" data-dir="-1" aria-label={t('Scroll left')} class="nav-arrow absolute top-1/2 left-1 z-10 hidden size-8 -translate-y-1/2 place-items-center rounded-full bg-surface text-muted shadow hover:text-ink"><svg viewBox="0 0 24 24" class="size-4"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
    <ul id="topic-scroll" class="no-scrollbar flex gap-1 overflow-x-auto scroll-smooth px-4 py-2.5 text-sm font-medium whitespace-nowrap sm:px-2">
      {topics.map((tp) => <li><a href={`#${tp.id}`} data-topic={tp.id} class="block rounded-full px-3 py-1 text-muted transition-colors hover:bg-surface-2 hover:text-ink">{tp.title}</a></li>)}
    </ul>
    <button type="button" data-dir="1" aria-label={t('Scroll right')} class="nav-arrow absolute top-1/2 right-1 z-10 hidden size-8 -translate-y-1/2 place-items-center rounded-full bg-surface text-muted shadow hover:text-ink"><svg viewBox="0 0 24 24" class="size-4"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
  </nav>

  <div class="mt-8 flex flex-col gap-6">
    {topics.map((tp) => {
      const qs = questions.filter((q) => q.topic === tp.id);
      return (
        <section id={tp.id} class="card scroll-mt-32 p-6 sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[1fr_1.35fr]">
            <div>
              <h2 class="font-display text-3xl font-semibold">{tp.title}</h2>
              <p class="mt-3 leading-relaxed">{tp.summary}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">{tp.scripture.map((s) => <span class="chip">{s}</span>)}</div>
              <p class="mt-4 border-l-2 border-gold pl-3 text-sm text-muted">{tp.milestone}</p>
            </div>
            <div class="flex flex-col gap-5">
              {qs.map((q) => (
                <div>
                  <p class="font-semibold">{q.text}</p>
                  <ul class="mt-2.5 grid gap-2">
                    {q.options.map((o) => {
                      const hs = holders(q.id, o.id);
                      return (
                        <li class="flex items-center gap-3 rounded-xl bg-surface-2/70 px-3 py-2">
                          <span class="w-36 flex-none text-sm font-medium sm:w-44">{o.short ?? o.label}</span>
                          <span class="flex flex-wrap gap-1">
                            {hs.length === 0 && <span class="text-xs text-muted"> - </span>}
                            {hs.map(({ d, s }) => (
                              <a href={href(lang, `/denominations/${d.id}`)} title={`${d.name}${s < 0.75 ? ` (${t('divided')})` : ''}`} style={s < 0.75 ? 'opacity:.4' : ''} class="transition hover:scale-110 hover:opacity-100">
                                <Badge id={d.id} color={d.color} size={26} />
                              </a>
                            ))}
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <section class="card mt-10 p-6">
    <h2 class="text-[11px] font-bold tracking-widest text-muted uppercase">{t('Legend')}</h2>
    <div class="mt-3 grid gap-2 sm:grid-cols-3 lg:grid-cols-6">
      {denominations.map((d) => (
        <a href={href(lang, `/denominations/${d.id}`)} class="flex items-center gap-2 text-sm hover:underline">
          <Badge id={d.id} color={d.color} size={24} />{d.short}
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .no-scrollbar { scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  #topic-scroll { mask-image: linear-gradient(to right, transparent, #000 24px, #000 calc(100% - 24px), transparent); }
</style>

<script>
  // Topic bar: mouse wheel scrolls sideways, arrow buttons when it overflows,
  // and the topic in view is highlighted and kept visible.
  const scroller = document.getElementById('topic-scroll')!;
  const arrows = [...document.querySelectorAll<HTMLButtonElement>('#topic-nav .nav-arrow')];
  function updateArrows() {
    const max = scroller.scrollWidth - scroller.clientWidth;
    arrows[0].style.display = scroller.scrollLeft > 4 ? 'grid' : 'none';
    arrows[1].style.display = scroller.scrollLeft < max - 4 ? 'grid' : 'none';
  }
  scroller.addEventListener('wheel', (e) => {
    if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
    const max = scroller.scrollWidth - scroller.clientWidth;
    if (max <= 0) return;
    e.preventDefault();
    scroller.scrollBy({ left: e.deltaY, behavior: 'auto' });
  }, { passive: false });
  scroller.addEventListener('scroll', updateArrows, { passive: true });
  addEventListener('resize', updateArrows);
  arrows.forEach((b) => b.addEventListener('click', () => scroller.scrollBy({ left: Number(b.dataset.dir) * scroller.clientWidth * 0.7 })));
  updateArrows();

  const links = new Map([...scroller.querySelectorAll<HTMLAnchorElement>('a[data-topic]')].map((a) => [a.dataset.topic!, a]));
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      links.forEach((a) => a.classList.remove('bg-surface-2', 'text-ink'));
      const a = links.get(e.target.id);
      if (!a) continue;
      a.classList.add('bg-surface-2', 'text-ink');
      const l = a.offsetLeft - scroller.clientWidth / 2 + a.offsetWidth / 2;
      scroller.scrollTo({ left: l, behavior: 'smooth' });
    }
  }, { rootMargin: '-40% 0px -55% 0px' });
  document.querySelectorAll('section[id]').forEach((s) => io.observe(s));
</script>
