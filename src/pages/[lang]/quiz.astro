---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.svelte';
import { dataFor } from '../../data/localized';
import { langPaths, useT, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const { questions, denominations, topicTitles } = dataFor(lang);
---
<Base title={t('Quiz')}>
  <Quiz client:load {questions} {denominations} topics={topicTitles} {lang} />
</Base>
