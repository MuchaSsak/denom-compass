---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.svelte';
import { questions } from '../data/questions';
import { denominations } from '../data/denominations';
import { topicTitles } from '../data/topics';
---
<Base>
  <!-- Already finished (and not mid-retake)? Go straight to results. -->
  <script is:inline slot="head">
    try {
      if (localStorage.getItem('dc:history:v1') && !localStorage.getItem('dc:progress:v1')) location.replace('/results');
    } catch {}
  </script>
  <Quiz client:load {questions} {denominations} topics={topicTitles} />
</Base>
