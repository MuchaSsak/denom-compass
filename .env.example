# OpenRouter key for the optional "AI reading" on the results page.
# Get one at https://openrouter.ai/keys — free models cost nothing.
OPENROUTER_API_KEY=

# Optional: override the model chain (comma-separated, first = primary).
# Default: nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_MODEL=
